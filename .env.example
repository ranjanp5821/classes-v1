# ─── Anam.ai Avatar (server-side only) ───────────────────────────────────────
# Copy this file to `.env` and fill in your real credentials from https://lab.anam.ai
# NOT prefixed with VITE_ so the API key is never bundled into client JS.
ANAM_API_KEY=your-anam-api-key
ANAM_AVATAR_ID=your-avatar-id
ANAM_VOICE_ID=your-voice-id
ANAM_LLM_ID=your-llm-id

# ─── Gemini (server-side only) — powers the GIF voice circle after Anam ──────
# /api/ask streams text replies; /api/tts speaks them in a clear neural voice.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash-lite          # text model for /api/ask
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts # voice model for /api/tts
GEMINI_TTS_VOICE=Kore                        # warm female voice (try Aoede, Leda, Zephyr)

# ─── Homework Scanner OCR / vision model ────────────────────────────────────
# Reads the page, grades it, and detects the page boundary. gemini-2.5-flash is
# the balanced pick (strong intelligence, fast, cost-effective). Alternatives:
#   gemini-2.5-pro       — most intelligent (slower, pricier)
#   gemini-2.5-flash-lite — cheapest/fastest (less accurate OCR)
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_VISION_FALLBACK=gemini-2.5-flash-lite  # used only if the primary is overloaded (503)

# ─── Finger/hand removal (server-side LaMa inpainting via Replicate) ─────────
# OPTIONAL. When both are set, /api/inpaint reconstructs the page under any
# fingers detected on a scan. Without them the scanner works unchanged (no
# inpainting). Get a token at https://replicate.com/account/api-tokens and a
# model version hash from a LaMa-style inpainting model that takes { image, mask }.
REPLICATE_API_TOKEN=
INPAINT_MODEL_VERSION=
